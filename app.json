{
  "expo": {
    "name": "Touround CRM",
    "slug": "touround-crm-mobile",
    "version": "1.0.3",
    "runtimeVersion": "1.0.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "touround-crm",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.touround.crm",
      "buildNumber": "1",
      "appStoreUrl": "",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to set your business address on the map.",
        "NSPhotoLibraryUsageDescription": "We need access to your photos to upload your business logo and cover image.",
        "NSPhotoLibraryAddUsageDescription": "We need permission to save photos to your library.",
        "NSCameraUsageDescription": "We need camera access to take photos for your business profile and posts.",
        "NSMicrophoneUsageDescription": "We need microphone access to record videos for your business profile.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyASyPpuufRkhcXfXjF5q69q0qw73izLV-I",
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.touround.touround_crm",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyASyPpuufRkhcXfXjF5q69q0qw73izLV-I"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Touround CRM to use your location to set your business address."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Touround CRM to access your photos for uploading business images.",
          "cameraPermission": "Allow Touround CRM to use your camera to take photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2bb5c4",
          "sounds": [],
          "mode": "production",
          "requestPermissionOnLoading": false
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/8082ad26-6c64-4507-a142-1504628762e2"
    },
    "owner": "ssibisi",
    "extra": {
      "eas": {
        "projectId": "8082ad26-6c64-4507-a142-1504628762e2"
      }
    }
  }
